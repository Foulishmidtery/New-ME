PORT=28789
PROV=
NODE_ENV=development

# Tambahkan origin lain dengan pemisah koma bila diperlukan.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL CMS utama
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kneks_new
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_lokal

# Path ini biasanya tidak perlu diisi jika kedua repository berdampingan.
# KNEKS_REACT_DIR=D:\path\ke\kneks_react
ENABLE_KHAS_IN_CMS=false

# Service eksternal yang diteruskan oleh Next.js. Biarkan default untuk lokal.
TAX_SERVICE_ORIGIN=http://127.0.0.1:8000
KHAS_SERVICE_ORIGIN=http://127.0.0.1:4001
SPES_ORIGIN=http://127.0.0.1:5173

# Upload legacy: default mengarah ke <project>/public/uploads dan tidak perlu diubah.
# PUBLIC_UPLOADS_DIR=/absolute/path/to/project/public/uploads
MAX_UPLOAD_BYTES=52428800

# Hanya diperlukan bila modul MySQL legacy masih dipakai selama fase kompatibilitas.
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=kneks
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_POOL_LIMIT=10
